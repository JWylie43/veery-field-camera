# Recordings and logs (never commit captured video / rendered output)
*.mkv
*.avi
*.mp4
*.mov
*.raw
*.yuv
*.nv12

# Python
__pycache__/
*.pyc
.venv/
venv/

# Calibration: keep the scripts + the cam0/cam1/stereo JSONs; ignore the
# snapshot images and the generated board/sample images
calibration/images-cam*/
calibration/images-pairs/
*_undistort_sample.jpg
*_rectified_sample.jpg
*_reprojection_sample.jpg

# Studio's C++ tools: ignore the build output
studio/native/build/
*.bin

# Kernel build tree (rock5t-camera/kernel-build/build-kernel.sh clones into it)
rock5t-camera/kernel-build/linux*/
rock5t-camera/kernel-build/*.deb
rock5t-camera/kernel-build/out/

# Editor / OS
.vscode/
.idea/
.claude/
.DS_Store

# studio/refine_extrinsics.py --apply backups (of calibration/stereo_extrinsics.json)
calibration/*.bak-*
studio/logs/

# Rock image builds: Radxa base image, kernel downloads, scratch and output
rock5t-camera/image-build/work/
rock5t-camera/image-build/out/
