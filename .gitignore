# Recordings and logs (never commit captured video / rendered output)
*.mkv
*.avi
*.mp4
*.mov
*.raw
*.yuv
*.nv12

# Python
__pycache__/
*.pyc
.venv/
venv/

# Calibration: keep the scripts + the cam0/cam1/stereo JSONs; ignore the
# snapshot images and the generated board/sample images
calibration/images-cam*/
charuco_board.png
*_undistort_sample.jpg
*_rectified_sample.jpg

# Stitching: keep source (stitch_pipeline.cpp/CMakeLists/include/pair_check.py);
# ignore build output and generated renders
stitching/build/
stitching/*_out/
stitching/output/
stitching/pipeline_out/
*.bin

# Kernel build tree (rock5t-camera/kernel-build/build-kernel.sh clones into it)
rock5t-camera/kernel-build/linux*/
rock5t-camera/kernel-build/*.deb

# Editor / OS
.vscode/
.idea/
.claude/
.DS_Store
