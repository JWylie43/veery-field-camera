#!/bin/bash
# camera-network - apply /config/camera-network.txt to NetworkManager, once: afterwards the
# file is renamed camera-network.applied.txt with its passwords blanked (camera-network.service
# runs this at boot; with no camera-network.txt it does nothing).
#   WIFI_NAME + WIFI_PASSWORD  -> a Wi-Fi connection, autoconnect priority 100: joined
#                                 whenever it is in range (only when both are filled in)
#   HOTSPOT_NAME               -> an access point (2.4 GHz, the Rock at 10.43.0.1),
#                                 priority -10, NOT autoconnect: wifi-fallback starts it
#                                 at boot only if no known Wi-Fi joins (a self-starting
#                                 hotspot wins the race against the first Wi-Fi scan);
#                                 HOTSPOT_PASSWORD blank = open hotspot
# The connection is named after the network (SSID). Re-applying replaces those two
# connections; other connections are left alone.
set -u
CONF=/config/camera-network.txt
DONE=/config/camera-network.applied.txt
[ -f "$CONF" ] || exit 0
get() { sed -nE "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*\"?([^\"]*)\"?[[:space:]]*\$/\\1/p" "$CONF" | tail -1; }
WIFI_NAME="$(get WIFI_NAME)";       WIFI_PASSWORD="$(get WIFI_PASSWORD)"
HOTSPOT_NAME="$(get HOTSPOT_NAME)"; HOTSPOT_PASSWORD="$(get HOTSPOT_PASSWORD)"

for _ in $(seq 1 60); do nmcli -t general status >/dev/null 2>&1 && break; sleep 1; done
DEV="$(nmcli -t -f DEVICE,TYPE device | awk -F: '$2=="wifi"{print $1; exit}')"
[ -n "$DEV" ] || { echo "camera-network: no Wi-Fi device"; exit 1; }
replace() { nmcli connection delete "$1" >/dev/null 2>&1 || true; }

ok=1
if [ -n "$WIFI_NAME" ] && [ -n "$WIFI_PASSWORD" ]; then
  replace "$WIFI_NAME"
  nmcli connection add type wifi con-name "$WIFI_NAME" ifname "$DEV" ssid "$WIFI_NAME" \
    wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$WIFI_PASSWORD" \
    connection.autoconnect yes connection.autoconnect-priority 100 >/dev/null \
    && echo "camera-network: Wi-Fi \"$WIFI_NAME\" (priority 100)" \
    || { echo "camera-network: could not add Wi-Fi \"$WIFI_NAME\""; ok=0; }
else
  echo "camera-network: no Wi-Fi (needs both WIFI_NAME and WIFI_PASSWORD)"
fi
if [ -n "$HOTSPOT_NAME" ]; then
  replace "$HOTSPOT_NAME"
  # WPA2 (RSN) with AES/CCMP only and PMF off - what NetworkManager's own hotspot command
  # sets. Left to the defaults, phones (iPhone, Mac) can refuse to join at all.
  sec=(); [ -n "$HOTSPOT_PASSWORD" ] && sec=(wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$HOTSPOT_PASSWORD"
    wifi-sec.proto rsn wifi-sec.pairwise ccmp wifi-sec.group ccmp wifi-sec.pmf disable)
  nmcli connection add type wifi con-name "$HOTSPOT_NAME" ifname "$DEV" ssid "$HOTSPOT_NAME" \
    802-11-wireless.mode ap 802-11-wireless.band bg ipv4.method shared ipv4.addresses 10.43.0.1/24 \
    "${sec[@]}" connection.autoconnect no connection.autoconnect-priority -10 >/dev/null \
    && echo "camera-network: hotspot \"$HOTSPOT_NAME\" ($([ -n "$HOTSPOT_PASSWORD" ] && echo password || echo OPEN), priority -10)" \
    || { echo "camera-network: could not add hotspot \"$HOTSPOT_NAME\""; ok=0; }
fi
# read once: keep the settings (minus passwords - those now live in NetworkManager,
# root-only) as camera-network.applied.txt
sed -E 's/^([[:space:]]*(WIFI|HOTSPOT)_PASSWORD[[:space:]]*=).*/\1""/' "$CONF" > "$DONE" && rm -f "$CONF"
[ "$ok" -eq 1 ]
