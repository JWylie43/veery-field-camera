[Unit]
# The rig's recorder: web control panel (previews, record button, files, /calib).
# Installed by rock5t-camera/setup.sh, which puts this checkout's real path in place
# of @REPO_DIR@ below. Then it is up at http://<rock-ip>:8080 on
# every boot. Takes go to ~/recordings of the user who owns the checkout.
# Logs:    journalctl -u recorder -f
# Manual:  sudo systemctl stop recorder   (before running server.py by hand,
#          or by-hand runs fail: only one process can hold a camera node)
Description=Stereo camera recorder - web control panel
Documentation=file://@REPO_DIR@/rock5t-camera/ROCK5T_CAMERA.md
# rkaiq_3A drives the ISP's exposure/colour; without it frames are unusable
After=network-online.target rkaiq_3A.service
Wants=network-online.target rkaiq_3A.service

[Service]
Type=simple
# runs as root so the panel can mount/unmount the offload drive itself -
# no privileged helper script or sudoers rule to maintain. The panel has no
# login and is reachable by anyone on the network it is attached to, so put a
# password on the field hotspot (see ROCK5T_CAMERA.md).
WorkingDirectory=@REPO_DIR@
ExecStart=/usr/bin/python3 @REPO_DIR@/rock5t-camera/recorder/server.py
# the camera pipeline settles a few seconds after the sensors probe (~12s);
# starting into a half-ready pipeline just makes the first previews fail
ExecStartPre=/bin/sleep 8
Restart=on-failure
RestartSec=10
# kill the gst children too (they run in their own process groups)
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
